{
  "name": "lulema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "个人打卡与 Cloudflare D1 私密同步",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "npx wrangler d1 migrations apply lulema --remote --config worker/wrangler.jsonc",
    "worker:dev": "npx wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.jsonc"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.164.0"
  }
}
