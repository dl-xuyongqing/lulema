{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lulema-api",
  "main": "index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://dl-xuyongqing.github.io,http://localhost:4173,http://127.0.0.1:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lulema",
      // 创建 D1 后，将 Cloudflare 返回的 database_id 填在此处。
      "database_id": "d3c6e863-7f0e-4046-9560-2204aa042441",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": false }
}
